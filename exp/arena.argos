<?xml version="1.0" ?>

<argos-configuration>
    <!-- —————————————————————————————————————————————————————————————————— -->
    <!-- General configuration                                              -->
    <!-- —————————————————————————————————————————————————————————————————— -->
    <framework>
        <system                         threads="0" />
        <experiment                     length="0"
                                        ticks_per_second="10"
                                        random_seed="0"
        />
    </framework>

    <!-- —————————————————————————————————————————————————————————————————— -->
    <!-- Controllers                                                        -->
    <!-- —————————————————————————————————————————————————————————————————— -->
    <controllers>
        <ros_thymio_controller          id="generic-controller"
                                        library="ros_thymio/libros_thymio.so"
        >
            <actuators>
                <differential_steering  implementation="default"
                                        noise_level="0.01"
                />
                <range_and_bearing      implementation="default"
                />
            </actuators>
            <sensors>
                <Thymio_proximity       implementation="default"
                                        noise_level="0.01"
                />
                <Thymio_ground          implementation="rot_z_only" />
                <differential_steering  implementation="default"
                                        noise_level="0.01"
                />
                <Thymio_range_and_bearing implementation="medium"
                                        medium="rab"
                                        show_rays="true"
                />
            </sensors>
            <params                     max_wheel_speed="10" />
        </ros_thymio_controller>
    </controllers>

    <!-- —————————————————————————————————————————————————————————————————— -->
    <!-- Loop functions                                                     -->
    <!-- —————————————————————————————————————————————————————————————————— -->
    <!-- Square arena centered in the origin (inner size 5 x 5 m).          -->
    <!-- Floor: white vertical band of white_width meters around X = 0;     -->
    <!-- black nest of radius nest_radius centered in (nest_x, 0); on the   -->
    <!-- left of the white band, a radial gradient from black (nest) to    -->
    <!-- gray (farthest left-side point);                                   -->
    <!-- uniform gray on the right of the white band.                       -->
    <loop_functions                     label="loopfunctions"
                                        library="loopfunctions/libloopfunctions.so"
                                        arena_side="5.0"
                                        white_width="0.5"
                                        nest_radius="0.35"
                                        nest_x="-1.8"
    />

    <!-- —————————————————————————————————————————————————————————————————— -->
    <!-- Arena configuration                                                -->
    <!-- —————————————————————————————————————————————————————————————————— -->
    <arena                              size="5.4, 5.4, 1"
                                        center="0,0,0.5"
                                        positional_grid_size="5,5,1"
    >
        <floor                          id="floor"
                                        source="loop_functions"
                                        pixels_per_meter="100"
        />
        <box                            id="wall-north"
                                        size="5.1, 0.05, 0.2"
                                        movable="false"
        >
            <body                       position="0, 2.525, 0"
                                        orientation="0, 0, 0"
            />
        </box>
        <box                            id="wall-south"
                                        size="5.1, 0.05, 0.2"
                                        movable="false"
        >
            <body                       position="0, -2.525, 0"
                                        orientation="0, 0, 0"
            />
        </box>
        <box                            id="wall-west"
                                        size="0.05, 5.0, 0.2"
                                        movable="false"
        >
            <body                       position="-2.525, 0, 0"
                                        orientation="0, 0, 0"
            />
        </box>
        <box                            id="wall-east"
                                        size="0.05, 5.0, 0.2"
                                        movable="false"
        >
            <body                       position="2.525, 0, 0"
                                        orientation="0, 0, 0"
            />
        </box>
        <!-- Passive prey: light movable cylinders on the right side, to be pushed into the nest. -->
        <distribute>
            <position                   method="uniform"
                                        min="0.5, -2.4, 0"
                                        max="2.4, 2.4, 0"
            />
            <orientation                method="constant"
                                        values="0, 0, 0"
            />
            <entity                     quantity="10"
                                        max_trials="10000"
            >
                <cylinder               id="prey_"
                                        radius="0.04"
                                        height="0.08"
                                        mass="0.05"
                                        movable="true"
                />
            </entity>
        </distribute>
        <distribute>
            <position                   method="uniform"
                                        min="-2.4, -2.4, 0"
                                        max="2.4, 2.4, 0"
            />
            <orientation                method="gaussian"
                                        mean="0, 0, 0"
                                        std_dev="360, 0, 0"
            />
            <entity                     quantity="10"
                                        max_trials="10000"
            >
                <Thymio                 id="thymio_"
                                        rab_range="0.5"
                                        rab_data_size="10"
                >
                    <controller         config="generic-controller" />
                </Thymio>
            </entity>
        </distribute>
    </arena>

    <!-- —————————————————————————————————————————————————————————————————— -->
    <!-- Physics engines                                                    -->
    <!-- —————————————————————————————————————————————————————————————————— -->
    <physics_engines>
        <dynamics2d                     id="dyn2d" />
    </physics_engines>

    <!-- —————————————————————————————————————————————————————————————————— -->
    <!-- Media                                                              -->
    <!-- —————————————————————————————————————————————————————————————————— -->
    <media>
        <range_and_bearing              id="rab"
                                        index="grid"
                                        grid_size="1, 1, 1"
        />
        <led                            id="leds" />
    </media>

    <!-- —————————————————————————————————————————————————————————————————— -->
    <!-- Visualization                                                      -->
    <!-- —————————————————————————————————————————————————————————————————— -->
    
    <!--    -->
    <visualization>
        <qt-opengl>
            <camera>
                <placements>
                    <placement          index="0"
                                        position="0, 0, 6.5"
                                        look_at="0, 0, 0"
                                        up="0, 1, 0"
                                        lens_focal_length="20"
                    />
                </placements>
            </camera>
        </qt-opengl>
    </visualization>

</argos-configuration>
