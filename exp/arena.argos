<?xml version="1.0" ?>

<argos-configuration>
    <!-- —————————————————————————————————————————————————————————————————— -->
    <!-- General configuration                                              -->
    <!-- —————————————————————————————————————————————————————————————————— -->
    <framework>
        <system                         threads="0" />
        <experiment                     length="0"
                                        ticks_per_second="10"
                                        random_seed="0"
        />
    </framework>

    <!-- —————————————————————————————————————————————————————————————————— -->
    <!-- Controllers                                                        -->
    <!-- —————————————————————————————————————————————————————————————————— -->
    <controllers>
        <ros_thymio_controller          id="generic-controller"
                                        library="ros_thymio/libros_thymio.so"
        >
            <actuators>
                <differential_steering  implementation="default"
                                        noise_level="0.01"
                />
                <range_and_bearing      implementation="default"
                />
            </actuators>
            <sensors>
                <Thymio_proximity       implementation="default"
                                        noise_level="0.01"
                />
                <Thymio_ground          implementation="rot_z_only" />
                <differential_steering  implementation="default"
                                        noise_level="0.01"
                />
                <Thymio_range_and_bearing implementation="medium"
                                        medium="rab"
                                        show_rays="true"
                />
            </sensors>
            <params                     max_wheel_speed="10" />
        </ros_thymio_controller>
    </controllers>

    <!-- —————————————————————————————————————————————————————————————————— -->
    <!-- Loop functions                                                     -->
    <!-- —————————————————————————————————————————————————————————————————— -->
    <!-- Corridor along X, centered in the origin (inner size 4 x 0.8 m).   -->
    <!-- Floor: black for the first black_length meters (X < 0 end),        -->
    <!-- white for white_length meters around X = 0, gray elsewhere.        -->
    <loop_functions                     label="loopfunctions"
                                        library="loopfunctions/libloopfunctions.so"
                                        corridor_length="4.0"
                                        black_length="0.5"
                                        white_length="0.5"
    />

    <!-- —————————————————————————————————————————————————————————————————— -->
    <!-- Arena configuration                                                -->
    <!-- —————————————————————————————————————————————————————————————————— -->
    <arena                              size="4.4, 1.2, 1"
                                        center="0,0,0.5"
                                        positional_grid_size="4,1,1"
    >
        <floor                          id="floor"
                                        source="loop_functions"
                                        pixels_per_meter="100"
        />
        <box                            id="wall-north"
                                        size="4.1, 0.05, 0.2"
                                        movable="false"
        >
            <body                       position="0, 0.425, 0"
                                        orientation="0, 0, 0"
            />
        </box>
        <box                            id="wall-south"
                                        size="4.1, 0.05, 0.2"
                                        movable="false"
        >
            <body                       position="0, -0.425, 0"
                                        orientation="0, 0, 0"
            />
        </box>
        <box                            id="wall-west"
                                        size="0.05, 0.8, 0.2"
                                        movable="false"
        >
            <body                       position="-2.025, 0, 0"
                                        orientation="0, 0, 0"
            />
        </box>
        <box                            id="wall-east"
                                        size="0.05, 0.8, 0.2"
                                        movable="false"
        >
            <body                       position="2.025, 0, 0"
                                        orientation="0, 0, 0"
            />
        </box>
        <distribute>
            <position                   method="uniform"
                                        min="-1.9, -0.32, 0"
                                        max="1.9, 0.32, 0"
            />
            <orientation                method="gaussian"
                                        mean="0, 0, 0"
                                        std_dev="360, 0, 0"
            />
            <entity                     quantity="10"
                                        max_trials="10000"
            >
                <Thymio                 id="thymio_"
                                        rab_range="0.5"
                                        rab_data_size="10"
                >
                    <controller         config="generic-controller" />
                </Thymio>
            </entity>
        </distribute>
    </arena>

    <!-- —————————————————————————————————————————————————————————————————— -->
    <!-- Physics engines                                                    -->
    <!-- —————————————————————————————————————————————————————————————————— -->
    <physics_engines>
        <dynamics2d                     id="dyn2d" />
    </physics_engines>

    <!-- —————————————————————————————————————————————————————————————————— -->
    <!-- Media                                                              -->
    <!-- —————————————————————————————————————————————————————————————————— -->
    <media>
        <range_and_bearing              id="rab"
                                        index="grid"
                                        grid_size="1, 1, 1"
        />
        <led                            id="leds" />
    </media>

    <!-- —————————————————————————————————————————————————————————————————— -->
    <!-- Visualization                                                      -->
    <!-- —————————————————————————————————————————————————————————————————— -->
    
    <!--    -->
    <visualization>
        <qt-opengl>
            <camera>
                <placements>
                    <placement          index="0"
                                        position="0, 0, 3.5"
                                        look_at="0, 0, 0"
                                        up="0, 1, 0"
                                        lens_focal_length="20"
                    />
                </placements>
            </camera>
        </qt-opengl>
    </visualization>

</argos-configuration>
